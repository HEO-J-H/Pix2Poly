# Copy to .env and adjust (optional; Pix2Poly reads OS env vars)

# Mesh backend: heightfield (CPU, default) | triposr | instantmesh | colmap
# PIX2POLY_MESH_BACKEND=heightfield

# TripoSR: clone https://github.com/VAST-AI-Research/TripoSR and set absolute path
# PIX2POLY_TRIPOSR_REPO_PATH=D:\repos\TripoSR
# Python that has TripoSR + PyTorch + CUDA (not the Pix2Poly venv unless you merged deps)
# PIX2POLY_TRIPOSR_PYTHON=D:\repos\TripoSR\.venv\Scripts\python.exe
# Optional: cuda:0 | cpu — passed to TripoSR run.py (run.bat sets cuda:0 via apply-triposr-env.bat)
# PIX2POLY_TRIPOSR_DEVICE=cuda:0

# InstantMesh: not auto-wired; see docs/gpu-worker.md
# PIX2POLY_INSTANTMESH_REPO_PATH=

# COLMAP multi-image / video SfM pipeline
# PIX2POLY_COLMAP_PATH=C:\Program Files\COLMAP\colmap.exe
# PIX2POLY_COLMAP_GPU=0

# FFmpeg for video frame extraction
# PIX2POLY_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# PIX2POLY_VIDEO_MAX_MB=500
# PIX2POLY_VIDEO_FPS=2
# PIX2POLY_VIDEO_MAX_FRAMES=60

# FBX export via Blender headless CLI
# PIX2POLY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
